# ============================================================
#  AI Grant & Funding Finder — Environment Configuration
#  IBM Cloud Lite + IBM Granite (watsonx.ai)
# ============================================================

# -----------------------------------------------------------
# IBM watsonx.ai (Granite LLM) — REQUIRED
# Get from: https://cloud.ibm.com/iam/apikeys
# -----------------------------------------------------------
IBM_API_KEY=your_ibm_cloud_api_key_here
IBM_WATSONX_URL=https://us-south.ml.cloud.ibm.com
IBM_PROJECT_ID=your_watsonx_project_id_here

# IBM Granite Model ID (IBM Granite 13B / 8B instruct)
IBM_GRANITE_MODEL_ID=ibm/granite-13b-instruct-v2

# -----------------------------------------------------------
# IBM Watson Natural Language Understanding (IBM Cloud Lite)
# Get from: https://cloud.ibm.com/catalog/services/natural-language-understanding
# -----------------------------------------------------------
IBM_NLU_API_KEY=your_nlu_api_key_here
IBM_NLU_URL=https://api.us-south.natural-language-understanding.watson.cloud.ibm.com/instances/your_instance_id

# -----------------------------------------------------------
# Flask Application Settings
# -----------------------------------------------------------
FLASK_APP=app.py
FLASK_ENV=development
FLASK_DEBUG=True
SECRET_KEY=aicte-grant-finder-secret-key-change-in-production
PORT=5000

# -----------------------------------------------------------
# Grant Data Sources (public RSS / API feeds)
# -----------------------------------------------------------
GRANTS_GOV_API=https://www.grants.gov/grantsws/rest/opportunities/search/
DST_INDIA_URL=https://dst.gov.in/
STARTUP_INDIA_URL=https://www.startupindia.gov.in/
NIDHI_URL=https://nidhi.dst.gov.in/
AICTE_URL=https://www.aicte-india.org/
MEITY_URL=https://www.meity.gov.in/

# -----------------------------------------------------------
# Data Refresh Interval (minutes)
# -----------------------------------------------------------
CACHE_REFRESH_INTERVAL=60
MAX_GRANTS_PER_PAGE=20

# -----------------------------------------------------------
# Application Logging
# -----------------------------------------------------------
LOG_LEVEL=INFO
LOG_FILE=logs/app.log
